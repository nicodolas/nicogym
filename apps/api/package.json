{
  "name": "@nicogym/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/require-direct-url.mjs && drizzle-kit migrate",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "catalog:seed": "tsx scripts/seed-catalog.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@neondatabase/serverless": "1.1.0",
    "better-auth": "1.6.26",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
